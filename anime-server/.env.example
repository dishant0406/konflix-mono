# Metadata provider per content type, as "type:provider" pairs.
#
# Available: anilist, kitsu, cinemeta, tvmaze, yts.
#
# A type may name several, most-preferred first, separated by "+". The next one
# answers when the first returns nothing or fails, so an outage degrades a row rather
# than emptying it.
#
# Cinemeta is preferred for films and series because it is a catalogue - every title
# that exists. YTS is a torrent tracker, whose catalogue is only what has been ripped,
# so a newly released film is missing from it even when the indexers hold releases.
# TVMaze stays in the series chain for its Indian television coverage.
#
# METADATA_PROVIDER overrides the anime entry, so the single-value setting still works.
PROVIDERS=anime:anilist,series:cinemeta+tvmaze,movie:cinemeta+yts
METADATA_PROVIDER=anilist

# Hosts for the metadata providers. Each is configurable because each has moved before.
# CINEMETA_BASE_URL covers both meta and catalogs: the service redirects between its
# hosts and the HTTP client follows.
TVMAZE_BASE_URL=https://api.tvmaze.com
CINEMETA_BASE_URL=https://v3-cinemeta.strem.io
YTS_BASE_URL=https://movies-api.accel.li/api/v2
KNABEN_BASE_URL=https://api.knaben.org/v1
EZTV_BASE_URL=https://eztv.wf/api

# Torrent indexers to search. Available: subsplease, nyaa, knaben, yts, eztv, apibay,
# animetosho. Each declares the content types it serves, so one list covers all of them.
#
# subsplease is the only anime-specific source that answers with every episode of a
# show from one request, so it is the fastest by a wide margin. knaben is a meta-search
# that aggregates The Pirate Bay, YTS, 1337x and Nyaa. yts is films and eztv is series.
#
# apibay and animetosho are deliberately absent. apibay answers 403 with a Cloudflare
# challenge from a datacenter IP (it works from a residential one, so the file is kept
# and it can be re-enabled here). animetosho stopped ingesting new torrents in May 2026,
# so it is a frozen archive with nothing for a currently airing show. A proxy does not
# help with either: the challenge follows the IP, not the request.
TORRENT_INDEXERS=subsplease,nyaa,knaben,yts,eztv

# How long one indexer request may take before it is abandoned. This bounds a hung
# request; it is deliberately above the slowest measured real response (~3.5s).
INDEXER_TIMEOUT_MS=5000

# Nyaa mirrors, tried in order. The canonical nyaa.si is blocked (503) on many
# networks, so a working mirror is used instead. Add or reorder as mirrors change.
NYAA_BASE_URLS=https://nyaa.si,https://nyaa.net

# Public trackers added to every magnet link.
TORRENT_TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://open.stealth.si:80/announce,udp://tracker.torrent.eu.org:451/announce,udp://exodus.desync.com:6969/announce

# Absolute address of this server. Stream URLs are built from it, so in production
# this must be the public URL (for example https://api.example.com).
PUBLIC_URL=http://localhost:9000

PORT=9000
CACHE_DIR=./.torrent-cache

# Torrent lifecycle
TORRENT_TTL_MINUTES=20
MAX_TORRENTS=12
# Upper bound on bytes held on disk by active torrents. MAX_TORRENTS alone is not a
# disk limit: a 1080p episode is roughly 1.4GB and an HLS conversion reads the whole file.
MAX_CACHE_BYTES=8589934592

# How long to wait for a magnet to find peers and report its file list. A swarm with
# real seeders can take longer than 30s to connect.
METADATA_TIMEOUT_MS=45000
PROBE_TIMEOUT_MS=20000
MAX_CANDIDATES=3

# Upper bound on resolving one episode, across all candidates
RESOLVE_DEADLINE_MS=75000

# --- HLS ---------------------------------------------------------------------
#
# A release whose container a phone cannot play (an MKV) is converted into HLS
# segments under CACHE_DIR/hls. Each session is one ffmpeg process and a directory
# holding the whole episode, so both are capped.
#
# A session is destroyed after this long without a request. A paused player stops
# fetching, so this is a grace period rather than a per-request timeout.
HLS_SESSION_TTL_MINUTES=30
MAX_HLS_SESSIONS=3

# How long to wait for ffmpeg to write the first playlist. Measured at under 3s.
HLS_START_TIMEOUT_MS=30000

# How long a request for a segment ffmpeg has not written yet may wait. A player asks
# for the segment after the one it is playing, so a short wait is normal.
HLS_SEGMENT_TIMEOUT_MS=30000

# --- Video source ------------------------------------------------------------
#
# Where the video bytes come from. One of: torrent, debrid
#
#   torrent  this server joins the swarm and relays every byte to the viewer. No
#            third party, no account, but all video traffic crosses this machine.
#
#   debrid   a debrid service (TorBox) has already fetched the torrent and hands back
#            a direct CDN link, which this server then relays. Video bytes still cross
#            this machine, because the CDN link carries the API key and must not be
#            handed to the browser. What it avoids is swarm membership, the torrent
#            disk cache, ffmpeg, and any dependence on peer connectivity.
#            Needs TORBOX_API_KEY.
STREAM_SOURCE=torrent

# Which sources may be used, in order. The first source that returns a playable
# result wins, so listing both gives a fallback when one has nothing.
#
#   STREAM_SOURCES=debrid,torrent   prefer the cached copy, fall back to relaying
#   STREAM_SOURCES=torrent          relay only
#
# The debrid path is usually faster to start and finds many popular episodes already
# cached (measured: 6-9 of the top 10 candidates for recent shows), but it is not a
# bandwidth saving, because the bytes are still relayed. See STREAM_SOURCE above.
STREAM_SOURCES=torrent

# TorBox API key (torbox.app). Required by the debrid source.
#
# Needs a PAID plan. The free plan has no API key at all (free users authenticate
# with a session token instead and cannot access the API), and is limited to 1
# download per 24 hours / 10 per month / 1 concurrent slot, which is not enough to
# stream from. The $1 24-hour Pro trial is the cheapest way to test.
#
# This is a secret: it is only ever sent server-side and never appears in a URL or a
# response. Check it was accepted with `curl localhost:9000/health`.
TORBOX_API_KEY=

# How long to wait for TorBox to answer. checkcached and requestdl are both fast;
# this only bounds a slow or unreachable API.
DEBRID_TIMEOUT_MS=15000

# Hosts a debrid download link is allowed to point at. The link comes from the debrid
# API rather than from a request, but this server fetches it, so it is allowlisted
# rather than trusted. An entry matches that host and any subdomain of it. A link
# outside this list is refused with a 502.
#
# The real host is a CDN node under one of these domains, e.g.
# nexus-144.enam.tb-cdn.io. This is NOT torbox.app: the API host and the CDN host are
# different domains, so allowlisting the API host rejects every link.
#
# The provider has rotated between .pw and .io, and may rotate again. When it does,
# every playback fails with a 502 and the api log names the rejected hostname - copy
# it here. This is the only setting that has needed changing in production.
DEBRID_CDN_HOSTS=tb-cdn.pw,tb-cdn.io
