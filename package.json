{
  "name": "akidev-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Akidev monorepo: media catalogue and streaming API plus its Next.js frontend",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "akidev-api",
    "akidev-frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=akidev-api & npm run dev --workspace=akidev",
    "start": "npm start --workspace=akidev-api",
    "build": "npm run build --workspace=akidev",
    "test": "npm test --workspace=akidev-api && npm test --workspace=akidev",
    "lint": "npm run lint --workspace=akidev"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
