{
  "name": "konflix-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Konflix monorepo: anime metadata and streaming API plus its Next.js frontend",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "anime-server",
    "konflix-frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=konflix-api & npm run dev --workspace=konflix",
    "start": "npm start --workspace=konflix-api",
    "build": "npm run build --workspace=konflix",
    "test": "npm test --workspace=konflix-api && npm test --workspace=konflix",
    "lint": "npm run lint --workspace=konflix"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
