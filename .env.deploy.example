# Deploy configuration for the Akidev stack.
#
# This file is only read by scripts/deploy.sh, which runs ON the server. The values
# here are the ones the containers and the build need; the SSH connection details are
# repository secrets consumed by the workflow, not entries in this file.
#
# Copy to .env.deploy and fill in, or let .github/workflows/deploy.yml render it from
# repository secrets. .env.deploy is gitignored: it holds the tunnel token and the
# debrid key.

# The API's public origin, with no path. PUBLIC_URL is what the server puts in the video URLs it
# hands out and NEXT_PUBLIC_API_URL is where the site calls it; they are the same address, and
# what the Cloudflare DNS record points at.
PUBLIC_URL=https://api.akidev.live
NEXT_PUBLIC_API_URL=https://api.akidev.live

# The zone every hostname is under. Baked into the frontend at build time as
# NEXT_PUBLIC_SITE_DOMAIN; it is the same value for every site, which is what lets one
# build serve all of them. Changing the zone means changing this and rebuilding.
NEXT_PUBLIC_SITE_DOMAIN=akidev.live

# The site, and the two retired hostnames that redirect to it. Used for the checks the
# workflow runs; the tunnel routing and the DNS records are what actually serve them. All three
# point at one container.
FRONTEND_URL=https://anime.akidev.live
TV_URL=https://tv.akidev.live
HUB_URL=https://akidev.live

# Stream sources, in order of preference. debrid serves from the TorBox CDN cache when the
# episode is there, torrent relays from the swarm otherwise, and archive-org is the last
# resort for what no torrent indexer has. The bytes of the first two pass through the api
# container: the debrid link carries the API key, so it is never handed to a browser.
STREAM_SOURCES=debrid,torrent,archive-org

# TorBox API key. Leave empty to run torrent-only.
TORBOX_API_KEY=

# Upper bound on the bytes the torrent downloads and the converted video may use together on
# the server's disk. Default is 12GiB.
MAX_CACHE_BYTES=12884901888

# Cloudflare named tunnel token, from:
#   cf tunnels token get <tunnel-id>
# The tunnel id is printed by scripts/cloudflare.sh.
CLOUDFLARE_TUNNEL_TOKEN=
