# Deploy configuration for the Konflix stack.
#
# This file is only read by scripts/deploy.sh, which runs ON the server. The values
# here are the ones the containers and the build need; the SSH connection details are
# repository secrets consumed by the workflow, not entries in this file.
#
# Copy to .env.deploy and fill in, or let .github/workflows/deploy.yml render it from
# repository secrets. .env.deploy is gitignored: it holds the tunnel token and the
# debrid key.

# The two public origins. These are what PUBLIC_URL and NEXT_PUBLIC_GRAPHQL_URI must
# be set to, and what the Cloudflare DNS records point at.
PUBLIC_URL=https://api.konflix.live
NEXT_PUBLIC_GRAPHQL_URI=https://api.konflix.live/graphql

# The frontend origin. Only used for the summary the deploy script prints; the tunnel
# routing and the DNS record are what actually serve it.
FRONTEND_URL=https://konflix.live

# Stream sources, in order of preference. debrid serves from the TorBox CDN cache when
# the episode is there, torrent relays from the swarm otherwise. Both relay the bytes
# through the api container; see anime-server/.env.example for why.
STREAM_SOURCES=debrid,torrent

# TorBox API key. Leave empty to run torrent-only.
TORBOX_API_KEY=

# Upper bound on torrent cache bytes on the server. Default is 12GiB.
MAX_CACHE_BYTES=12884901888

# Cloudflare named tunnel token, from:
#   cf tunnels token get <tunnel-id>
# The tunnel id is printed by scripts/cloudflare.sh.
CLOUDFLARE_TUNNEL_TOKEN=
