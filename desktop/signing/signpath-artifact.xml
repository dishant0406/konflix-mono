<?xml version="1.0" encoding="utf-8"?>
<!-- The artifact configuration to create in SignPath for the Windows release: the workflow sends
     a zip holding the installer, and this signs the installer inside it. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Akidev-*-x86_64-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
