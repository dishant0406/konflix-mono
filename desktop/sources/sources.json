    {
      "id": "yts",
      "kinds": [
        "movie"
      ],
      "base_url": "https://movies-api.accel.li/api/v2",
      "types": {
        "movie": "movie"
      },
      "sorts": {
        "default": "download_count",
        "score": "rating",
        "recent": "date_added",
        "title": "title"
      },
      "card": {
        "id": "id",
        "title": {
          "coalesce": [
            "title_english",
            "title"
          ]
        },
        "title_variants": [
          "title_english",
          "title"
        ],
        "poster": {
          "coalesce": [
            "large_cover_image",
            "medium_cover_image"
          ]
        },
        "banner": {
          "coalesce": [
            "background_image_original",
            "background_image"
          ]
        },
        "format": {
          "const": "MOVIE"
        },
        "status": {
          "const": "FINISHED"
        },
        "year": "year",
        "episodes": {
          "const": "1"
        },
        "runtime_minutes": "runtime",
        "score": {
          "scale": {
            "from": "rating",
            "by": 10
          }
        },
        "popularity": "like_count",
        "genres": "genres"
      },
      "list": {
        "request": {
          "url": "{base}/list_movies.json",
          "query": {
            "sort_by": "{sort}",
            "order_by": "desc",
            "limit": "{per_page}",
            "page": "{page}",
            "minimum_rating": "5",
            "genre?": "{genre_lower}"
          }
        },
        "rows": "data.movies",
        "check": {
          "ok": {
            "path": "status",
            "equals": "ok"
          },
          "message": "status_message"
        },
        "drop": [
          {
            "path": "year",
            "exists": false
          },
          {
            "path": "year",
            "outside_recent_years": {
              "behind": 1,
              "grace_days": 30
            },
            "when": "sort:recent"
          }
        ],
        "year": "year",
        "paging": {
          "per_page": 24,
          "max": 50,
          "style": "page",
          "next": {
            "total": "data.movie_count"
          },
          "widen": {
            "when": [
              "year",
              "sort:recent"
            ],
            "per_page": 50
          }
        }
      },
      "search": {
        "request": {
          "url": "{base}/list_movies.json",
          "query": {
            "query_term": "{term}",
            "limit": "{per_page}",
            "page": "{page}"
          }
        },
        "rows": "data.movies",
        "check": {
          "ok": {
            "path": "status",
            "equals": "ok"
          },
          "message": "status_message"
        },
        "per_page": 50,
        "next": {
          "total": "data.movie_count"
        }
      },
      "detail": {
        "request": {
          "url": "{base}/movie_details.json",
          "query": {
            "movie_id": "{id}",
            "with_cast": "true",
            "with_images": "true"
          }
        },
        "id_pattern": "^[0-9]+$",
        "check": {
          "ok": {
            "path": "status",
            "equals": "ok"
          },
          "message": "status_message"
        },
        "root": "data.movie",
        "missing": [
          {
            "path": "title",
            "exists": false
          },
          {
            "path": "id",
            "equals": "0"
          }
        ],
        "description": {
          "coalesce": [
            "description_full",
            "summary"
          ]
        },
        "imdb_id": "imdb_code",
        "trailer": {
          "site": {
            "const": "youtube"
          },
          "id": "yt_trailer_code"
        },
        "cast": {
          "sources": [
            {
              "rows": "cast",
              "name": "name",
              "role": "character_name",
              "image": "url_small_image"
            }
          ]
        },
        "recommended": {
          "request": {
            "url": "{base}/movie_suggestions.json",
            "query": {
              "movie_id": "{id}"
            }
          },
          "check": {
            "ok": {
              "path": "status",
              "equals": "ok"
            },
            "message": "status_message"
          },
          "rows": "data.movies",
          "limit": 12
        }
      }
    }
  ],
  "chains": {
    "anime": [
      "anilist"
    ],
    "series": [
      "cinemeta",
      "tvmaze"
    ],
    "movie": [
      "cinemeta",
      "yts"
    ]
  }
}
